<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="promptDialog" title="GLOBAL PROMPT REPOSITORY" contentWidth="2000px" contentHeight="400px">
        <content>
            <Table id="promptTable2" inset="true" items="{promptsModel2>/prompts}">
                <headerToolbar>
                    <Toolbar id="_IDGenToolbar1">
                        <Title id="_IDGenTitle1" text="Prompts Details" />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn" width="10%">
                        <header>
                            <Label id="_IDGenLabel1" text="ID" />
                        </header>
                    </Column>
                     <Column id="_IDGenColumn1" width="40%">
                        <header>
                            <Label id="_IDGenLabel8" text="System Prompt" />
                        </header>
                    </Column>
                    <Column id="_IDGenColumn2" width="40%">
                        <header>
                            <Label id="_IDGenLabel9" text="User Prompt" />
                        </header>
                    </Column>
                   
                    <!-- <Column width="18%">-->
                    <!--    <header>-->
                    <!--        <Label text="Comment" />-->
                    <!--    </header>-->
                    <!--</Column>-->
                    <!-- <Column width="14%">-->
                    <!--    <header>-->
                    <!--        <Label text="Rating" />-->
                    <!--    </header>-->
                    <!--</Column>-->
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem" type="Active" press="onPromptItemDoubleClick">
                        <cells>
                            <Text id="_IDGenText15" text="{promptsModel2>PromptId}" />
                             <Text id="_IDGenText16" text="{promptsModel2>description}" />
                            <Text id="_IDGenText17" text="{promptsModel2>name}" />
                           
                           <!-- <Text text="{promptsModel>comment}" />-->
                           <!--<RatingIndicator  value="{promptsModel>rating}"  maxValue="5" editable="false"  iconSize="0.5rem"/>-->

                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <buttons>
            <Button id="_IDGenButton8" text="Close" width="150px" type="Emphasized" press="onClosePromptSelection" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>




