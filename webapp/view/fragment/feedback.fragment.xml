<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified">
	<Dialog id="id_feedback" title=" Provide Feedback" stretchOnPhone="true" class="tittlefeedback">
		<VBox class="sapUiContentPadding feedback label feedback2" width="100%">
			<!-- Issue Type -->
			<HBox class="sapUiTinyMarginBottom">
				<Label text="Select Issue Type *" labelFor="issueTypeSelect" design="Bold" class="sapUiSmallMarginEnd "/>
				<Select id="issueTypeSelect" width="48%" placeholder="Select Issue Type" class="feedback2">
					<items>
						<core:Item key="Select Issue Type" text="Select Issue Type"/>
						<core:Item key="tool" text="Tool Issues"/>
						<core:Item key="feature" text="New Feature"/>
						<core:Item key="access" text="Access Related"/>
						<core:Item key="others" text="Others"/>
					</items>
				</Select>
			</HBox>
			<!-- Priority -->
			<HBox class="sapUiTinyMarginBottom">
				<Label text="Set Priority" labelFor="prioritySelect" design="Bold" class="sapUiLargeMarginEnd "/>
				<Select id="prioritySelect" width="48%" placeholder="Set Priority" class="feedback2 marginleftlabel">
					<items>
						<core:Item key="Set Priority" text="Set Priority"/>
						<core:Item key="low" text="Low"/>
						<core:Item key="medium" text="Medium"/>
						<core:Item key="high" text="High"/>
					</items>
				</Select>
			</HBox>
			<!-- Title -->
			<HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom feedbacktext">
				<Label text="Title *" labelFor="titleInput" design="Bold"/>
				<Input id="titleInput" width="75%" placeholder="Enter a brief title for your feedback."/>
			</HBox>
			<!-- Description -->
			<HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom feedbacktext">
				<Label text="Description *" labelFor="descriptionInput" design="Bold"/>
				<TextArea id="descriptionInput" rows="5" placeholder="Provide a detailed description of the issue or suggestion (1024 characters max)"
					maxLength="1024" width="75%"/>
			</HBox>
			<HBox width="100%" class="sapUiTinyMarginBottom ">
				<Label text="Attach Files:" class="label2 sapUiLargeMarginEnd"/>
				<HBox alignItems="Center">
					<u:FileUploader id="fileUploader" name="myFileUpload" uploadUrl="upload/" buttonOnly="true" buttonText="Browse"
						uploadComplete="handleUploadComplete" change=".onFileChangeFeedback"
						fileType="docx,pdf,png,jpg,jpeg" maximumFileSize="10" fileSizeExceed=".handleFileSizeExceed" typeMissmatch=".handleTypeMissmatch"/>
					<core:Icon id="fileUploadSuccessIcon" src="sap-icon://accept" color="green" visible="false" class="sapUiTinyMarginStart"/>
					<Text id="fileNameText" text="" visible="false" class="sapUiTinyMarginStart"/>
				</HBox>
			</HBox>
			<!-- MessageStrip for error display -->
			<MessageStrip id="fileUploadError" type="Error" text="File size exceeds 10 MB. Please upload a smaller file." visible="false"/>
			<HBox>
				<Text text="*Note:If you're unable to submit feedback, please drop an " wrapping="true" class="sapUiTinyMarginTop sapUiTinyMarginBottom  "/>
				<Link text=" email  " href="mailto:sapcoeinnovationteam@capgemini.com" target="_blank" class="sapUiTinyMarginTop sapUiTinyMarginBottom"/>
				<Text text=" to our support team for assistance." wrapping="true" class="sapUiTinyMarginTop sapUiTinyMarginBottom"/>
			</HBox>
		</VBox>
		<!-- Dialog Buttons -->
		<buttons>
			<Button text="Submit" press=".OnSubmitPress"/>
			<Button text="Clear" press=".onClearPress"/>
			<Button text="Cancel" press=".onCancelPress"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>