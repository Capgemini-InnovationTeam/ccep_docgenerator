<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="promptParameter" title="Prompt Parameters">
        <content>
            <IconTabBar headerMode="Inline">
                <items>
                    <IconTabFilter text="Parameters" icon="sap-icon://table-view">

                        <Label design="Bold" text="Max response"/>
                        <FlexBox renderType="Bare" class="case1 sapUiSmallMarginBottom" alignItems="Center">
                            <items>
                                <Slider id="heightSlider" editable="false" class="paramSlider" width="70%"
                                    value="{apiModel>/max_tokens}" step="100" min="0" max="12000" ariaLabelledBy="heightLabel"/>
                                <Input width="80px" class="sapUiTinyMarginBegin" editable="false"
                                    value="{path:'apiModel>/max_tokens', type:'sap.ui.model.type.Integer'}" ariaLabelledBy="heightLabel"/>
                            </items>
                        </FlexBox>

                        <Label design="Bold" text="Temperature"/>
                        <FlexBox renderType="Bare" class="case1" alignItems="Center">
                            <items>
                                <Slider id="heightSlider1" class="paramSlider" width="70%"
                                    value="{apiModel>/temperature}" step="0.1" min="0" max="1" ariaLabelledBy="heightLabel"/>
                                <Input width="80px" class="sapUiTinyMarginBegin"
                                    value="{path:'apiModel>/temperature', type:'sap.ui.model.type.Float'}" ariaLabelledBy="heightLabel"/>
                            </items>
                        </FlexBox>

                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
        <buttons>
            <Button text="Save and Close" width="150px" type="Emphasized" press="onCloseParametersDialog"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>